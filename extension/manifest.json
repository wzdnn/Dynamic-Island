{
  "manifest_version": 3,
  "name": "Dynamic Island · WhatsApp Web",
  "version": "1.0.0",
  "description": "Notifikasi pesan dan indikasi panggilan WhatsApp Web ke Dynamic Island lokal.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Dynamic Island · WhatsApp Web" },
  "content_scripts": [
    { "matches": ["https://web.whatsapp.com/*"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://web.whatsapp.com/*"], "js": ["content.js"], "run_at": "document_start" }
  ]
}
